<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plan dnia"
        Height="680"
        Width="1050"
        MinHeight="600"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F4F1E9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Navy" Color="#26352F"/>
        <SolidColorBrush x:Key="Olive" Color="#73836A"/>
        <SolidColorBrush x:Key="Paper" Color="#FFFEFA"/>
        <SolidColorBrush x:Key="Muted" Color="#858A80"/>

        <Style x:Key="MainButton" TargetType="Button">
            <Setter Property="Background" Value="#73836A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#5D7055"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D0D7CC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="#35463D"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="Background" Value="#F7F6F0"/>
            <Setter Property="Foreground" Value="#26352F"/>
            <Setter Property="BorderBrush" Value="#E6E4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel boczny -->
        <Border Grid.Column="0" Background="#26352F">
            <Grid Margin="22,26,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,35">
                    <Border Width="43"
                            Height="43"
                            CornerRadius="13"
                            Background="#73836A"
                            HorizontalAlignment="Left">
                        <TextBlock Text="dp"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="dzień po swojemu"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="#FFFEFA"
                               Margin="0,15,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="MENU"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#829185"
                               Margin="12,0,0,10"/>

                    <Button Content="◷    Plan dnia"
                            Style="{StaticResource NavButton}"
                            Background="#35463D"
                            Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Główna zawartość -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="34,28,34,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Nagłówek -->
                <Grid Grid.Row="0" Margin="0,0,0,27">
                    <StackPanel>
                        <TextBlock x:Name="DateBlock"
                                   Text="DATA"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#73836A"/>

                        <TextBlock Text="Plan dnia"
                                   FontSize="31"
                                   FontWeight="SemiBold"
                                   Foreground="#26352F"
                                   Margin="0,6,0,5"/>
                    </StackPanel>
                </Grid>

                <!-- Postęp -->
                <Border Grid.Row="1"
                        Background="#E5E8DC"
                        CornerRadius="16"
                        Padding="21"
                        Margin="0,0,0,23">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="POSTĘP"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#65765B"/>

                            <TextBlock x:Name="ProgressText"
                                       Text="Brak zadań"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#26352F"
                                       Margin="0,8,0,12"/>

                            <ProgressBar x:Name="TaskProgress"
                                         Height="6"
                                         Width="260"
                                         Maximum="100"
                                         Value="0"
                                         HorizontalAlignment="Left"
                                         Background="#D1D8C7"
                                         Foreground="#73836A"
                                         BorderThickness="0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="58"
                                Height="58"
                                CornerRadius="29"
                                Background="#FFFEFA"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ProgressPercent"
                                       Text="0%"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#52654A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Dodawanie zadań -->
                <StackPanel Grid.Row="2" Margin="0,0,0,23">
                    <TextBlock Text="Dodaj zadanie"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#26352F"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TaskInput"
                                 Grid.Column="0"
                                 Height="46"
                                 Margin="0,0,10,0"
                                 ToolTip="Wpisz treść zadania"
                                 KeyDown="TaskInputKeyDown"/>

                        <Button Grid.Column="1"
                                Content="+  Dodaj"
                                Style="{StaticResource MainButton}"
                                Click="AddTask"/>
                    </Grid>
                </StackPanel>

                <!-- Nagłówek listy -->
                <Grid Grid.Row="3" Margin="0,0,0,12">
                    <TextBlock Text="Lista zadań"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#26352F"/>

                    <TextBlock x:Name="TaskCountBlock"
                               Text="0 zadań"
                               FontSize="12"
                               Foreground="#858A80"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Zadania -->
                <Border Grid.Row="4"
                        Background="#FFFEFA"
                        BorderBrush="#E9E6DC"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="12"
                        MinHeight="150"
                        VerticalAlignment="Top">

                    <StackPanel x:Name="TasksPanel"/>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
